<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <!--
            Only the four surface parity tests, so coverage reflects what the
            corpus exercises. The harness's own self-tests (GoldenCodecTest,
            AssertsGoldenTest) run under the default suite, not the gate.
        -->
        <testsuite name="parity">
            <file>tests/Parity/ClassLikeLookupParityTest.php</file>
            <file>tests/Parity/ChildrenOfParityTest.php</file>
            <file>tests/Parity/PrefixSearchParityTest.php</file>
            <file>tests/Parity/WritePathParityTest.php</file>
        </testsuite>
    </testsuites>
    <!--
        Coverage is restricted to the production surfaces Steps 2-4 migrate, so the
        Step P gate measures whether the parity corpus exercises every branch of
        exactly those classes and nothing else. See docs/architecture/0002-execution-plan.md.
    -->
    <source>
        <include>
            <file>src/Repository/DefaultClassRepository.php</file>
            <file>src/Index/SymbolIndex.php</file>
            <file>src/Index/DocumentIndexer.php</file>
            <file>src/Index/SymbolExtractor.php</file>
            <file>src/Index/CompositeNamespaceCatalog.php</file>
            <file>src/Index/CachedNamespaceCatalog.php</file>
            <file>src/Index/WorkspaceNamespaceSource.php</file>
            <file>src/Index/ComposerNamespaceSource.php</file>
            <file>src/Index/ReflectionNamespaceSource.php</file>
            <file>src/Index/NamespaceContents.php</file>
            <file>src/Index/NamespaceCatalogFactory.php</file>
        </include>
    </source>
</phpunit>
