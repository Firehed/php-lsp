parameters:
	ignoreErrors:
		-
			message: '#^class constant fetch on a computed class name; name the class literally \(RFC 1 §4\.5\)\.$#'
			identifier: phpLsp.dynamicClassReference
			count: 2
			path: src/Domain/TypeFactory.php

		-
			message: '#^\=\=\= on CompletionItemKind branches per symbol kind; use predicates \(RFC 1 §4\.5\)\.$#'
			identifier: phpLsp.kindInspection
			count: 1
			path: src/Handler/CompletionHandler.php

		-
			message: '#^\!\=\= on NameKind branches per symbol kind; use predicates \(RFC 1 §4\.5\)\.$#'
			identifier: phpLsp.kindInspection
			count: 1
			path: src/Index/ComposerSymbolLocator.php

		-
			message: '#^in_array on SymbolKind branches per symbol kind; use predicates \(RFC 1 §4\.5\)\.$#'
			identifier: phpLsp.kindInspection
			count: 1
			path: src/Index/SymbolIndex.php

		-
			message: '#^\!\=\= on NameKind branches per symbol kind; use predicates \(RFC 1 §4\.5\)\.$#'
			identifier: phpLsp.kindInspection
			count: 1
			path: src/Index/WorkspaceNamespaceSource.php

		-
			message: '#^match on SymbolKind branches per symbol kind; use predicates \(RFC 1 §4\.5\)\.$#'
			identifier: phpLsp.kindInspection
			count: 1
			path: src/Index/WorkspaceNamespaceSource.php

		-
			message: '#^new ClassName is confined to TypeFactory; use TypeFactory methods instead \(RFC 1 §4\.6\)\.$#'
			identifier: phpLsp.typeConstruction
			count: 6
			path: src/Repository/DefaultClassInfoFactory.php

		-
			message: '#^new PrimitiveType is confined to TypeFactory; use TypeFactory methods instead \(RFC 1 §4\.6\)\.$#'
			identifier: phpLsp.typeConstruction
			count: 3
			path: src/Repository/DefaultClassInfoFactory.php

		-
			message: '#^new UnionType is confined to TypeFactory; use TypeFactory methods instead \(RFC 1 §4\.6\)\.$#'
			identifier: phpLsp.typeConstruction
			count: 1
			path: src/Repository/DefaultClassInfoFactory.php

		-
			message: '#^\=\=\= on ClassKind branches per symbol kind; use predicates \(RFC 1 §4\.5\)\.$#'
			identifier: phpLsp.kindInspection
			count: 1
			path: src/Repository/MemberResolver.php

		-
			message: '#^instanceof on a computed class name; name the class literally \(RFC 1 §4\.5\)\.$#'
			identifier: phpLsp.dynamicClassReference
			count: 2
			path: src/Repository/MemberResolver.php

		-
			message: '#^match on MemberFilter branches per symbol kind; use predicates \(RFC 1 §4\.5\)\.$#'
			identifier: phpLsp.kindInspection
			count: 1
			path: src/Repository/MemberResolver.php

		-
			message: '#^\!\=\= on MemberFilter branches per symbol kind; use predicates \(RFC 1 §4\.5\)\.$#'
			identifier: phpLsp.kindInspection
			count: 1
			path: src/Resolution/SymbolResolver.php

		-
			message: '#^new ClassName is confined to TypeFactory; use TypeFactory methods instead \(RFC 1 §4\.6\)\.$#'
			identifier: phpLsp.typeConstruction
			count: 5
			path: src/Resolution/SymbolResolver.php

		-
			message: '#^new ClassName is confined to TypeFactory; use TypeFactory methods instead \(RFC 1 §4\.6\)\.$#'
			identifier: phpLsp.typeConstruction
			count: 1
			path: src/Utility/Scope.php
