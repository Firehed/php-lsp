includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - phpstan-baseline.neon

parameters:
    # Default-deny capability confinement: each mechanism below is usable only in
    # its named home(s). A new use elsewhere is a duplicate implementation waiting
    # to happen — extend the authority instead.
    #
    # Every entry in the three disallowed* blocks has the same shape, and each
    # part has one edit meaning (docs/architecture/enforcement-edits.md):
    #   namespace / function / method  — the deny list. Adding tightens.
    #   allowIn                        — the allowlist. Adding loosens (human only).
    #                                    On a new entry, each path must be one file
    #                                    that calls the denied thing today.
    #   message                        — text only. Changing it is lateral, and the
    #                                    baseline must be regenerated at the same total.
    disallowedNamespaces:
        -
            namespace: 'PhpParser\NodeTraverser'
            message: 'AST traversal is confined: parser pipeline (ParserService), positional finders (NodeAtPosition, Scope, ScopeFinder), and DeclarationScanner'
            allowIn:
                - src/Parser/ParserService.php
                - src/Index/NodeAtPosition.php
                - src/Knowledge/DeclarationScanner.php
                - src/Utility/Scope.php
                - src/Utility/ScopeFinder.php
                - tests/*
        -
            namespace: 'PhpParser\NodeFinder'
            message: 'AST traversal is confined: parser pipeline (ParserService), positional finders (NodeAtPosition, Scope, ScopeFinder), and DeclarationScanner'
            allowIn:
                - src/Parser/ParserService.php
                - src/Index/NodeAtPosition.php
                - src/Knowledge/DeclarationScanner.php
                - src/Utility/Scope.php
                - src/Utility/ScopeFinder.php
                - tests/*
        -
            namespace: 'Reflection*'
            message: 'runtime reflection is confined: ReflectionNamespaceSource and the fromReflection factories'
            allowIn:
                - src/Knowledge/ReflectionSymbolInfoFactory.php
                - src/Index/ReflectionNamespaceSource.php
                - src/Repository/ClassInfoFactory.php
                - src/Repository/DefaultClassInfoFactory.php
                - src/Domain/TypeFactory.php
                - src/Domain/FunctionInfo.php
                - src/Domain/ParameterInfo.php
                - tests/*
        -
            namespace:
                - 'PhpParser\ParserFactory'
                - 'PhpParser\Parser'
                - 'PhpParser\Parser\*'
                - 'PhpParser\Lexer*'
            message: 'an AST is produced in one place: ParserService'
            allowIn:
                - src/Parser/ParserService.php
                - tests/*
        -
            namespace: 'PhpParser\NodeVisitor*'
            message: 'AST traversal is confined: parser pipeline (ParserService), positional finders (NodeAtPosition, Scope, ScopeFinder), and DeclarationScanner'
            allowIn:
                - src/Parser/ParserService.php
                - src/Index/NodeAtPosition.php
                - src/Knowledge/DeclarationScanner.php
                - src/Utility/Scope.php
                - src/Utility/ScopeFinder.php
                - tests/*

    disallowedFunctionCalls:
        -
            function:
                - 'strtolower()'
                - 'strcasecmp()'
                - 'strncasecmp()'
                - 'mb_strtolower()'
                - 'strtoupper()'
                - 'mb_strtoupper()'
                - 'mb_convert_case()'
                - 'ucfirst()'
                - 'ucwords()'
                - 'lcfirst()'
                - 'strnatcasecmp()'
                - 'natcasesort()'
                - 'str_ireplace()'
                - 'stripos()'
                - 'strripos()'
                - 'stristr()'
                - 'mb_stripos()'
                - 'mb_strripos()'
                - 'mb_stristr()'
                - 'substr_compare()'
                - 'array_change_key_case()'
            message: 'which case rule a name follows is NameKind (symbols) or MemberKind (class-like members); applying one is NameCase'
            allowIn:
                - src/Domain/NameCase.php
                - src/Domain/NamespacePath.php # namespace paths are case-insensitive for every kind; not a symbol name
                - src/Transport/MessageReader.php # HTTP header names
                - src/Domain/Visibility.php # visibility keywords
                - tests/*
        -
            function:
                - 'preg_match()'
                - 'preg_match_all()'
                - 'preg_replace()'
                - 'preg_split()'
                - 'preg_quote()'
                - 'preg_replace_callback()'
                - 'preg_replace_callback_array()'
                - 'preg_grep()'
                - 'fnmatch()'
                - 'mb_ereg()'
                - 'mb_eregi()'
                - 'mb_ereg_match()'
                - 'mb_ereg_replace()'
                - 'mb_eregi_replace()'
                - 'mb_ereg_replace_callback()'
                - 'mb_ereg_search()'
                - 'mb_split()'
            message: 'text-pattern analysis is the mid-edit resilience rim: CompletionClassifier, DocblockParser, TextFallbackHelper'
            allowIn:
                - src/Completion/CompletionClassifier.php
                - src/Utility/DocblockParser.php
                - src/Resolution/TextFallbackHelper.php
                - tests/*
        -
            function:
                - 'get_defined_functions()'
                - 'get_declared_classes()'
                - 'get_declared_interfaces()'
                - 'get_declared_traits()'
                - 'get_class_methods()'
                - 'get_class_vars()'
                - 'get_object_vars()'
                - 'get_included_files()'
                - 'spl_autoload_functions()'
            message: 'asking the runtime what it has loaded is enumeration, confined to ReflectionNamespaceSource'
            allowIn:
                - src/Index/ReflectionNamespaceSource.php
                - tests/*
        -
            function:
                - 'get_defined_constants()'
            message: 'the internal constant set is built in InternalConstantSet, which owns the "is this constant built-in?" check PHP has no ReflectionConstant::isInternal for'
            allowIn:
                - src/Index/InternalConstantSet.php
                - tests/*
        -
            function:
                - 'class_exists()'
                - 'constant()'
                - 'defined()'
                - 'enum_exists()'
                - 'function_exists()'
                - 'interface_exists()'
                - 'trait_exists()'
                - 'method_exists()'
                - 'property_exists()'
                - 'is_callable()'
            message: 'asking the runtime whether a symbol exists, or what it holds, is a SymbolSource query (RFC 1 §4.2); ReflectionSymbolInfoFactory is the one place it may be the server''s own runtime'
            allowIn:
                - src/Knowledge/ReflectionSymbolInfoFactory.php
                - tests/*
        -
            function:
                - 'get_class()'
                - 'get_parent_class()'
                - 'is_a()'
                - 'is_subclass_of()'
                - 'class_implements()'
                - 'class_parents()'
                - 'class_uses()'
                - 'get_debug_type()'
                - 'gettype()'
            message: 'asking the runtime for a value''s concrete kind is kind inspection (RFC 1 §4.5); use predicates'
            allowIn:
                - tests/*
        -
            function:
                - 'token_get_all()'
                - 'token_name()'
            message: 'lexing outside the parser is the token rim: ContextDetector'
            allowIn:
                - src/Completion/ContextDetector.php
                - tests/*
        -
            function:
                - 'file_get_contents()'
                - 'file_exists()'
                - 'is_file()'
                - 'is_dir()'
                - 'scandir()'
                - 'glob()'
                - 'fopen()'
                - 'realpath()'
                - 'is_readable()'
                - 'is_writable()'
                - 'is_link()'
                - 'file()'
                - 'readfile()'
                - 'filemtime()'
                - 'filesize()'
                - 'stat()'
                - 'opendir()'
                - 'readdir()'
                - 'fread()'
                - 'fgets()'
                - 'fwrite()'
                - 'stream_get_contents()'
                - 'file_put_contents()'
                - 'unlink()'
                - 'mkdir()'
                - 'rmdir()'
                - 'touch()'
                - 'copy()'
                - 'rename()'
                - 'tempnam()'
                - 'tmpfile()'
                - 'fputs()'
                - 'fclose()'
                - 'feof()'
                - 'fflush()'
                - 'fseek()'
                - 'ftell()'
                - 'rewind()'
                - 'flock()'
                - 'fstat()'
                - 'ftruncate()'
                - 'fpassthru()'
                - 'fscanf()'
                - 'fgetcsv()'
                - 'fputcsv()'
                - 'fprintf()'
                - 'set_file_buffer()'
                - 'stream_get_meta_data()'
                - 'stream_set_blocking()'
                - 'stream_select()'
                - 'stream_copy_to_stream()'
                - 'dir()'
                - 'closedir()'
                - 'rewinddir()'
                - 'is_writeable()'
                - 'is_executable()'
                - 'lstat()'
                - 'clearstatcache()'
                - 'fileatime()'
                - 'filectime()'
                - 'fileowner()'
                - 'filegroup()'
                - 'fileperms()'
                - 'filetype()'
                - 'readlink()'
                - 'symlink()'
                - 'link()'
                - 'chmod()'
                - 'chown()'
                - 'chgrp()'
                - 'umask()'
                - 'disk_free_space()'
                - 'disk_total_space()'
                - 'parse_ini_file()'
                - 'move_uploaded_file()'
            message: 'filesystem access is confined: ParserService reads source, ComposerAutoloadMap/ComposerNamespaceSource read Composer metadata, transport owns its streams'
            allowIn:
                - src/Parser/ParserService.php
                - src/Index/ComposerAutoloadMap.php
                - src/Index/ComposerNamespaceSource.php
                - src/Transport/*
                - tests/*

    disallowedStaticCalls:
        -
            method: 'PhpToken::tokenize()'
            message: 'lexing outside the parser is the token rim: ContextDetector'
            allowIn:
                - tests/*

    disallowedClasses:
        -
            class: 'Firehed\PhpLsp\Knowledge\SymbolSource'
            message: 'handlers resolve symbols through CodeResolver (RFC 1 §4.2); SymbolSource is the knowledge tier one layer down'
            allowIn:
                - src/Completion/* # completion sources own their lookups
                - src/Knowledge/*
                - src/Repository/*
                - src/Resolution/*
                - tests/*
        -
            class:
                - 'DirectoryIterator'
                - 'RecursiveDirectoryIterator'
                - 'FilesystemIterator'
                - 'GlobIterator'
                - 'SplFileInfo'
                - 'SplFileObject'
                - 'SplTempFileObject'
            message: 'filesystem access is confined, and its readers (ParserService, ComposerAutoloadMap, ComposerNamespaceSource, transport) reach the disk through functions rather than through a file object'
            allowIn:
                - tests/*

    disallowedMethodCalls:
        -
            method: 'Firehed\PhpLsp\Cache\Invalidatable::invalidate()'
            message: 'single write path (RFC 1 §5.2/§5.3): every cached on-disk holder forgets a changed file together, which is DocumentSymbolSink''s fan-out; evicting one leaves the others stale'
            allowIn:
                - src/Knowledge/DocumentSymbolSink.php
                - src/Handler/DidChangeWatchedFilesHandler.php # the watched-file trigger, which calls the sink
                - tests/*
        -
            method: 'Firehed\PhpLsp\Knowledge\OpenDocumentBackend::updateDocument()'
            message: 'single write path (RFC 1 §4.3/§5.2): document symbol registration goes through DocumentSymbolSink'
            allowIn:
                - src/Knowledge/DocumentSymbolSink.php
                - tests/*
        -
            method: 'Firehed\PhpLsp\Knowledge\OpenDocumentBackend::removeDocument()'
            message: 'single write path (RFC 1 §4.3/§5.2): document symbol registration goes through DocumentSymbolSink'
            allowIn:
                - src/Knowledge/DocumentSymbolSink.php
                - src/Knowledge/OpenDocumentBackend.php
                - tests/*
        -
            method: 'Firehed\PhpLsp\Index\SymbolIndex::add()'
            message: 'single write path (RFC 1 §4.3/§5.2): symbol indexing goes through DocumentIndexer'
            allowIn:
                - src/Index/DocumentIndexer.php
                - tests/*
        -
            method: 'Firehed\PhpLsp\Index\SymbolIndex::clearByUri()'
            message: 'single write path (RFC 1 §4.3/§5.2): symbol indexing goes through DocumentIndexer'
            allowIn:
                - src/Index/DocumentIndexer.php
                - tests/*

    level: max
    paths:
        - src
        - tests
    # Adding a path here removes it from every check: loosen (human only).
    excludePaths:
        - tests/Fixtures
        # Deliberate rule violations, analysed only by RuleTestCase.
        - tests/Architecture/data

services:
    # RFC 1 §8.1 enforcement mechanisms. Registering a rule tightens; removing
    # one loosens (human only). Each rule's own lists are documented on its
    # constants.
    -
        class: Firehed\PhpLsp\Tests\Architecture\RawInitializeCapabilitiesRule
        tags:
            - phpstan.rules.rule
    -
        class: Firehed\PhpLsp\Tests\Architecture\TypeConstructionRule
        tags:
            - phpstan.rules.rule
    -
        class: Firehed\PhpLsp\Tests\Architecture\KindInspectionRule
        tags:
            - phpstan.rules.rule
    -
        class: Firehed\PhpLsp\Tests\Architecture\KindBranchRule
        tags:
            - phpstan.rules.rule
    -
        class: Firehed\PhpLsp\Tests\Architecture\DynamicClassReferenceRule
        tags:
            - phpstan.rules.rule
    -
        class: Firehed\PhpLsp\Tests\Architecture\FileInclusionRule
        tags:
            - phpstan.rules.rule
    -
        class: Firehed\PhpLsp\Tests\Architecture\FormatComparisonRule
        tags:
            - phpstan.rules.rule
    -
        class: Firehed\PhpLsp\Tests\Architecture\SymbolDiscoveryAuthorityExtension
        tags:
            - phpstan.restrictedClassNameUsageExtension
