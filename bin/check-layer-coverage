#!/usr/bin/env php
<?php

declare(strict_types=1);

// deptrac does not analyse a class that belongs to no layer, so such a class
// may depend on anything and the layer contract never sees it. Fails when
// `deptrac debug:unassigned` lists a class other than the one deliberately
// unlayered value (see deptrac.yaml).

$deliberatelyUnlayered = ['Firehed\PhpLsp\ServerInfo'];

$output = shell_exec(__DIR__ . '/../vendor/bin/deptrac debug:unassigned');
$unassigned = preg_split('/\R/', trim(is_string($output) ? $output : ''), -1, PREG_SPLIT_NO_EMPTY);
$unexpected = array_values(array_diff($unassigned, $deliberatelyUnlayered));

if ($unexpected === []) {
    echo "every class is in a deptrac layer\n";
    exit(0);
}

fwrite(STDERR, "classes in no deptrac layer (add a layer in deptrac.yaml):\n  " . implode("\n  ", $unexpected) . "\n");
exit(1);
