#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Firehed\Container\AutoDetect;
use Firehed\PhpLsp\Server;

// Future: this should (probably) be based on whether this is being run within
// as a dev dependency or standalone (e.g. composer global install)
$_ENV['ENVIRONMENT'] = 'dev';
// Don't rely on cwd(); tack to installation path. Avoids conflicts with
// projects also using the same container.
$container = AutoDetect::from(__DIR__ . '/../config');

$server = $container->get(Server::class);

exit($server->run());
